<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F4F7F6">
  <LinearLayout android:id="@+id/root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp" android:gravity="center_vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/daily_hisab" android:textColor="#137C66" android:textStyle="bold" android:letterSpacing="0.15" android:textSize="14sp" />
    <TextView android:id="@+id/authTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/your_money_na_clearer_picture" android:textSize="34sp" android:textStyle="bold" android:textColor="#172E28" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="28dp" android:text="@string/track_everyday_income_and_expenses_in_taka" android:textSize="16sp" android:textColor="#60756D" />
    <EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="56dp" android:hint="@string/your_name" android:inputType="textPersonName" android:maxLength="80" android:visibility="gone" />
    <EditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="56dp" android:hint="@string/email_address" android:inputType="textEmailAddress" android:maxLength="190" />
    <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="56dp" android:hint="@string/password_at_least_8_characters" android:inputType="textPassword" android:maxLength="64" />
    <TextView android:id="@+id/authError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3261E" android:accessibilityLiveRegion="polite" android:layout_marginTop="12dp" />
    <Button android:id="@+id/submit" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:text="@string/log_in" android:backgroundTint="#137C66" android:textColor="#FFFFFF" />
    <Button android:id="@+id/switchAuth" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/new_here_create_an_account" style="?android:attr/borderlessButtonStyle" />
    <Button android:id="@+id/server" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_settings" style="?android:attr/borderlessButtonStyle" />
  <Button android:id="@+id/language" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/language" style="?android:attr/borderlessButtonStyle"/></LinearLayout>
</ScrollView>